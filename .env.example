# Copy to .env and fill in your own values.

# Telegram bot + technical alerts channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_TECH_CHAT_ID=

# Monitored project (defaults shown)
SIGNAL_PROJECT_DIR=/home/trading/trading_project_signal
TRADING_DIR=/home/trading/trading_project_signal
SERVICES=trading-signal,trading-monitor,trading-dashboard

# Supabase health check + keep-alive (anon key is enough: read-only)
SUPABASE_URL=
SUPABASE_KEY=
